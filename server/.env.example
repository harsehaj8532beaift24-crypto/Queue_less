# QueueLess Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# For Local MongoDB (Default development):
# MONGODB_URI=mongodb://127.0.0.1:27017/queueless
#
# For MongoDB Atlas (Production / Cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/queueless?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/queueless

# JWT Authentication
JWT_SECRET=queueless_super_secret_jwt_key_2026_dev_secure_token
JWT_EXPIRES_IN=7d

# Frontend Client URL (for CORS and Socket.IO)
CLIENT_URL=http://localhost:5173

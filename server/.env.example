# QueueLess Backend Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String:
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/queueless
# MongoDB Atlas (Production Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/queueless?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=queueless_super_secret_jwt_key_2026_dev_secure_token
JWT_EXPIRE=7d

# Frontend Base URL (used for CORS and generating mobile-scannable QR code links)
# For local mobile testing (same Wi-Fi): use your machine's LAN IP, e.g. http://192.168.1.100:5173
# For production: use your deployed domain, e.g. https://queueless.yourdomain.com
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

